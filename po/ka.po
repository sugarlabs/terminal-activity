#: activity/activity.info:2
msgid "Terminal"
msgstr "ტერმინალი"

#: activity/activity.info:3
msgid "Here you have complete control over your computer. You are in charge!!"
msgstr "აქედან კომპიუტერს სრულად მართავთ. პასუხისმგებელი პირი თქვენ ბრძანდებით!"

#: helpbutton.py:41
msgid "Help"
msgstr "დახმარება"

#: terminal.py:174
msgid "Clear scrollback"
msgstr ""

#: terminal.py:224
msgid "Zoom out"
msgstr "დაპატარავება"

#: terminal.py:231
msgid "Zoom in"
msgstr "გადიდება"

#: terminal.py:238
msgid "Fullscreen"
msgstr "სრულ ეკრანზე"

#: terminal.py:264
msgid "Useful commands"
msgstr "სასარგებლო ბრძანებები"

#: terminal.py:265
msgid "cd"
msgstr "cd"

#: terminal.py:266
msgid "Change directory"
msgstr "საქაღალდის შეცვლა"

#: terminal.py:267
msgid "To use it, write: cd directory"
msgstr "გამოსაყენებლად აკრიფეთ: cd საქაღალდე"

#: terminal.py:269
msgid ""
"If you call it without parameters, will change\n"
"to the user directory"
msgstr ""
"თუ მას პარამეტრებით გამოიძახებთ, ის მომხმარებლის\n"
"საწყის საქაღალდეზე გადავა"

#: terminal.py:271
msgid "ls"
msgstr "ls"

#: terminal.py:272
msgid "List the content of a directory."
msgstr "საქაღალდის შემცველობის ჩამონათვალი."

#: terminal.py:273
msgid "To use it, write: ls directory"
msgstr "გამოსაყენებლად აკრიფეთ: ls საქაღალდე"

#: terminal.py:275
msgid ""
"If you call it without parameters, will list the\n"
"working directory"
msgstr ""
"თუ მას პარამეტრების გარეშე გამოიძახებთ, მიიღებთ\n"
"მიმდინარე საქაღალდის ჩამონათვალს"

#: terminal.py:277
msgid "cp"
msgstr "cp"

#: terminal.py:278
msgid "Copy a file to a specific location"
msgstr "აკოპირებს ფაილს მითითებულ მდებარეობაზე"

#: terminal.py:279
msgid "Call it with the file and the new location"
msgstr "გამოიძახეთ ის ფაილით და ახალი მდებარეობით"

#: terminal.py:280
msgid "Use: cp file directory"
msgstr "გამოყენება: cp ფაილი საქაღალდე"

#: terminal.py:281
msgid "rm"
msgstr "rm"

#: terminal.py:282
msgid "Removes a file in any path"
msgstr "წაშლის ფაილს ნებისმიერი ბილიკიდან"

#: terminal.py:283
msgid "Use: rm file"
msgstr "გამოყენება: rm ფაილი"

#: terminal.py:284
msgid "su"
msgstr "su"

#: terminal.py:285
msgid "Login as superuser (root)"
msgstr "ზემომხმარებლით (root) შესვლა"

#: terminal.py:287
msgid ""
"The root user is the administrator of the\n"
"system"
msgstr ""
"მომხმარებელი root\n"
"სისტემის ადმინისტრატორია"

#: terminal.py:289
msgid ""
"You must be careful, because you can modify\n"
"system files"
msgstr ""
"ფრთხილად უნდა იყოთ, რადგან შეგიძლიათ\n"
"სისტემური ფაილების შეცვლა"
